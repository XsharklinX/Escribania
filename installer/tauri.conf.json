{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Instalar Escribanía",
  "version": "1.0.0",
  "identifier": "com.escribania.setup",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Instalar Escribanía",
        "width": 760,
        "height": 480,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "center": true,
        "theme": "Light",
        "backgroundColor": "#F4F2EC"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
